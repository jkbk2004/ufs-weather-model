<?xml version="1.0"?>
<!DOCTYPE workflow [
  <!ENTITY PATHRT "{{ PATHRT }}">
  <!ENTITY LOG "{{ LOG }}">
  <!ENTITY PATHTR "{{ PATHTR }}">
  <!ENTITY RTPWD "{{ RTPWD }}">
  <!ENTITY RUNDIR_ROOT "{{ RUNDIR_ROOT }}">
  <!ENTITY NEW_BASELINE "{{ NEW_BASELINE }}">
  {% for key, value in machine_config.items() if key.startswith("INPUTDATA_ROOT") %}
  <!ENTITY {{ key }} "{{ value }}">
  {% endfor %}
]>

<workflow realtime="F" scheduler="{{ machine_config.SCHEDULER }}" taskthrottle="10">
  <cycledef>197001010000 197001010000 01:00:00</cycledef>
  <log>&LOG;/workflow.log</log>

  {% set compile_tasks = TESTS | selectattr("type", "equalto", "compile") | list %}
  {% set run_tasks = TESTS | selectattr("type", "equalto", "run") | list %}

  {% for compile in compile_tasks %}
  <!-- Compile task for {{ compile.id }} -->
  <task name="{{ compile.name }}" maxtries="3">
    <command>{{ compile.command | replace("2>&1", "2>&amp;1") }}</command>
    <jobname>{{ compile.jobname }}</jobname>
    <account>{{ compile.account or '' }}</account>
    <queue>{{ compile.queue or '' }}</queue>
    <partition>{{ compile.partition or '' }}</partition>
    <nodes>{{ compile.nodes }}</nodes>
    <walltime>{{ compile.walltime }}</walltime>
    <join>{{ compile.join }}</join>
  </task>

  {% set children = run_tasks | selectattr("parent", "equalto", compile.id) | list %}
  {% if children %}
  <!-- Run tasks dependent on {{ compile.name }} -->
  <metatask name="run_{{ compile.id }}_tasks">
    <var name="zero">0</var>
    {% for task in children %}
    <task name="{{ task.name }}" maxtries="3">
      <dependency>
        {% if task.dependency %}
        <and>
          <taskdep task="{{ compile.name }}"/>
          <taskdep task="{{ task.dependency }}_{{ task.compiler }}"/>
        </and>
        {% else %}
        <taskdep task="{{ compile.name }}"/>
        {% endif %}
      </dependency>
      <command>{{ task.command | replace("2>&1", "2>&amp;1") }}</command>
      <jobname>{{ task.jobname }}</jobname>
      <account>{{ task.account }}</account>
      <queue>{{ task.queue }}</queue>
      <partition>{{ task.partition }}</partition>
      <nodes>{{ task.nodes }}</nodes>
      <walltime>{{ task.walltime }}</walltime>
      <join>{{ task.join }}</join>
    </task>
    {% endfor %}
  </metatask>
  {% endif %}
  {% endfor %}
</workflow>
